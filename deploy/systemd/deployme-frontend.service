[Unit]
Description=DeployMe frontend
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=deployme
Group=deployme
WorkingDirectory=/opt/deployme/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --env-file=/etc/deployme/frontend.env node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3001
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30s
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target