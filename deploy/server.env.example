NODE_ENV=production
API_HOST=127.0.0.1
PORT=3000

# PostgreSQL connection used by Prisma.
DATABASE_URL=REPLACE_WITH_PRODUCTION_POSTGRES_URL

# Direct/session-affine connection for PostgreSQL LISTEN.
# Do not use a transaction-pooling endpoint.
REALTIME_DATABASE_URL=REPLACE_WITH_DIRECT_POSTGRES_URL

REDIS_URL=REPLACE_WITH_PRODUCTION_REDIS_URL

# Exact origins, including https://; no paths.
FRONTEND_ORIGIN=REPLACE_WITH_DASHBOARD_ORIGIN
ADMIN_ORIGIN=REPLACE_WITH_ADMIN_ORIGIN

OTP_SECRET=REPLACE_WITH_RANDOM_SECRET

RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
RESEND_FROM=REPLACE_WITH_VERIFIED_SENDER

GITHUB_APP_ID=REPLACE_WITH_NUMERIC_APP_ID
GITHUB_APP_PRIVATE_KEY="REPLACE_WITH_PRIVATE_KEY_PEM"
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

GITHUB_APP_CLIENT_ID=REPLACE_WITH_CLIENT_ID
GITHUB_APP_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
GITHUB_APP_CALLBACK_URL=REPLACE_WITH_REGISTERED_CALLBACK_URL

# Exactly 64 hexadecimal characters.
GITHUB_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_ENCRYPTION_KEY

R2_BUCKET_NAME=REPLACE_WITH_BUCKET_NAME
R2_ENDPOINT=REPLACE_WITH_R2_ENDPOINT
R2_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY

DOCKER_SOCKET_PATH=/var/run/docker.sock
TRUST_LOCAL_PROXY=true