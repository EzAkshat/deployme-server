{
  "name": "DeployMeServer",
  "version": "1.0.0",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "worker:outbox": "tsx --env-file-if-exists=.env src/workers/outbox-dispatcher.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "test": "node scripts/test-runner.mjs parallel",
    "test:unit": "node scripts/test-runner.mjs unit",
    "test:integration": "node scripts/test-runner.mjs integration",
    "test:serial": "node scripts/test-runner.mjs serial",
    "worker:deployment": "tsx --env-file-if-exists=.env src/workers/deployment-worker.ts",
    "test:db:migrate": "node scripts/test-runner.mjs migrate",
    "test:services:up": "docker compose -f compose.test.yml up -d --wait",
    "test:services:stop": "docker compose -f compose.test.yml stop"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@octokit/app": "^16.1.4",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.4.0",
    "cors": "^2.8.6",
    "dockerode": "^5.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^6.0.0",
    "mime-types": "^3.0.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "resend": "^6.34.1",
    "tar-stream": "^3.2.2",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/tar-stream": "^3.1.5",
    "@types/yauzl": "^3.4.0",
    "dotenv": "^18.0.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.15.0 <23"
  }
}
